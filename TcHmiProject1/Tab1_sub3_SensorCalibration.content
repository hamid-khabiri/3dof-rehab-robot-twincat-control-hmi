<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiButton_20.onMouseUp",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "setTimeout(function () {",
          "    var region = TcHmi.Controls.get('TcHmiRegion_7');",
          "    if (region) {",
          "        region.setTargetContent('Tab1_Sub4_UserSecuring.content', function (data) {",
          "            if (data.error === TcHmi.Errors.NONE) {",
          "                console.log('OK, now showing:', region.getTargetContent());",
          "            } else {",
          "                console.error('Swap failed, error code:', data.error);",
          "            }",
          "        });",
          "    }",
          "}, 0);"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%TcHmiEllipse_15::Visibility%/ctrl%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:framework#/definitions/Visibility",
          "value": "Visible"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%TcHmiLine_2::Visibility%/ctrl%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:framework#/definitions/Visibility",
          "value": "Visible"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
