||
%s%PLC1.GVL_HMI.HomingError%/s%
||
%s%PLC1.GVL_HMI.HardwareLimitisActived%/s%
)
? 'Visible'    : 'Collapsed'%/f%" data-tchmi-zindex="8" data-tchmi-opacity="1" data-tchmi-creator-visibility="Visible" data-tchmi-target-content="%f%(
  %s%PLC1.GVL_HMI.EmergencyStopIsOnSoftware%/s%
)
?
'EmergencyStopSoftwarePopup.content'
:
(
  %s%PLC1.GVL_HMI.EmergencyStopIsOnHardware%/s%
)
?
'EmergencyStopHardwarePopup.content'
:
(
  %s%PLC1.GVL_HMI.HomingError%/s%
)
?
'HommingError.content'
:
(
  %s%PLC1.GVL_HMI.HardwareLimitisActived%/s%
)
?
'EmergencyStopSoftwarePopup.content'
:
''%/f%">
