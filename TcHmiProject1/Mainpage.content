<div id="TcHmiRectangle_43" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiRectangle" data-tchmi-height="1080" data-tchmi-height-unit="px" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-top="0" data-tchmi-top-unit="px" data-tchmi-width="1920" data-tchmi-width-unit="px" data-tchmi-opacity="0.7" data-tchmi-zindex="6" data-tchmi-visibility="%f%(%s%PLC1.GVL_HMI.EmergencyStopIsOnSoftware%/s%||%s%PLC1.GVL_HMI.EmergencyStopIsOnHardware%/s%||
%s%PLC1.GVL_HMI.HomingError%/s%||
%s%PLC1.GVL_HMI.HardwareLimitisActived%/s%
) ? 'Visible' : 'Collapsed'
%/f%" data-tchmi-background-color="%f%(
  %s%PLC1.GVL_HMI.EmergencyStopIsOnSoftware%/s%
)
?
{ color: 'rgba(255, 203, 40, 1)' }
:
(
  (
    %s%PLC1.GVL_HMI.EmergencyStopIsOnHardware%/s%
  )
  ?
  { color: 'rgba(197, 48, 48, 1)' }
  :
  (
    %s%PLC1.GVL_HMI.HomingError%/s%
  )
  ?
  { color: 'rgba(74, 35, 90, 1)' }
  :
  (
    %s%PLC1.GVL_HMI.HardwareLimitisActived%/s%
  )
  ?
  { color: 'rgba(180, 126, 100, 1)' }
  :
  { color: 'rgba(255, 255, 255, 1)' }
)%/f%" data-tchmi-creator-locked="True" data-tchmi-creator-visibility="Collapsed">



