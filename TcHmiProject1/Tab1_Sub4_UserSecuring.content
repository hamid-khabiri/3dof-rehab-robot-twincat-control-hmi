<div id="TcHmiImage_51" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiImage" data-tchmi-height="117" data-tchmi-height-unit="px" data-tchmi-left="-20" data-tchmi-left-unit="px" data-tchmi-top="425" data-tchmi-top-unit="px" data-tchmi-width="139" data-tchmi-width-unit="px" data-tchmi-src="Images/Arrow_Left.svg" data-tchmi-zindex="2">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiImage_51.onMouseUp",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "setTimeout(function () {",
          "    var region = TcHmi.Controls.get('TcHmiRegion_9');",
          "    if (!region) return;",
          "",
          "    var currentContent = region.getTargetContent();",
          "",
          "    var num = parseInt(currentContent.replace('HumanSecuring', '').replace('.content', ''));",
          "",
          "    num = num - 1;",
          "    if (num < 1) num = 6;",
          "",
          "    region.setTargetContent('HumanSecuring' + num + '.content');",
          "}, 0);"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiImage_52" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiImage" data-tchmi-height="117" data-tchmi-height-unit="px" data-tchmi-left="871" data-tchmi-left-unit="px" data-tchmi-top="425" data-tchmi-top-unit="px" data-tchmi-width="139" data-tchmi-width-unit="px" data-tchmi-src="Images/Arrow_Right.svg" data-tchmi-zindex="1">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "TcHmiImage_52.onMouseUp",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "setTimeout(function () {",
          "    var region = TcHmi.Controls.get('TcHmiRegion_9');",
          "    if (!region) return;",
          "",
          "    // read what content is currently shown",
          "    var currentContent = region.getTargetContent();   // e.g. \"HumanSecuring3.content\"",
          "",
          "    // extract the number from the name",
          "    var num = parseInt(currentContent.replace('HumanSecuring', '').replace('.content', ''));",
          "",
          "    // next, wrap 6 -> 1",
          "    num = num + 1;",
          "    if (num > 6) num = 1;",
          "",
          "    region.setTargetContent('HumanSecuring' + num + '.content');",
          "}, 0);"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
