}
</script>

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "LOGIN.onMouseUp",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "var username = TcHmi.Controls.get('Username').getText();",
          "var password = TcHmi.Controls.get('Password').getText();",
          "",
          "if (username === 'Admin' && password === 'Admin')",
          "{",
          "    TcHmi.Controls.get('TcHmiRegion')",
          "        .setTargetContent('PatientsPage.content');",
          "}",
          "else",
          "{",
          "    alert('Invalid username or password');",
          "}"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  },
  {
    "event": "LOGIN.onMouseUp",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "var username = TcHmi.Controls.get('Username').getText();",
          "var password = TcHmi.Controls.get('Password').getText();",
          "",
          "if (username === 'Admin' && password === 'Admin')",
          "{",
          "    TcHmi.Controls.get('TcHmiRegion')",
          "        .setTargetContent('PatientsPage.content');",
          "}",
          "else",
          "{",
          "    alert('Invalid username or password');",
          "}"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
