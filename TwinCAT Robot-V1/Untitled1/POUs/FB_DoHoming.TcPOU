<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_DoHoming" Id="{24e8fc17-5e50-4741-9205-ef0495f488ad}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DoHoming
VAR_INPUT
	 HStart : BOOL;            (* Start homing *)
END_VAR
VAR_OUTPUT
	 HM123Done: BOOL;            (* Homing finished *)
	 HomingError : BOOL;
END_VAR
VAR
	 StateM1Homing : INT := 0;
	 StateM2M3Homing : INT := 0;
	 
   
   

    (* Velocity control FBs *)
    fbVelM1  : MC_MoveVelocity;
	fbVelM2  : MC_MoveVelocity;
    fbVelM3  : MC_MoveVelocity;
	fbMoReM1  : MC_MoveRelative;
	fbMoReM2  : MC_MoveRelative;
	fbMoReM3  : MC_MoveRelative;
	fbStopM1 : MC_Halt;
    fbStopM2 : MC_Halt;
    fbStopM3 : MC_Halt;
	
	

    (* Parameters *)
   	vBetaHome: LREAL:= 0.5; 			  (* safe speed for beta homing *)
	vThetaHome : LREAL := 0.5;    (* safe speed for theta homing *)
    vRHome     : LREAL := 0.5;    (* safe speed for R homing *)
	SwTheta1 : BOOL;
	SwR1: BOOL;
	
	
	StateM1: INT;
	SwBeta1: BOOL;
	HM1Done: BOOL;
	
	SwTheta2: BOOL;
	SwR2: BOOL;
	SwBeta2: BOOL;
	
	// Torque
	
    TorqueM1 : LREAL;
    TorqueM2 : LREAL;
    TorqueM3 : LREAL;
	TorqueLimitHome : LREAL := 60.0;
	tOverTorque : TON;
	fbStopLockM1: MC_STOP;
	fbStopLockM2: MC_STOP;
	fbStopLockM3: MC_STOP;
	
	// moves after contacting to Microswitch to reach nutral possition
	rSwBeta1  : R_TRIG;
	rSwTheta1 : R_TRIG;
	rSwR2 : R_TRIG;
	fbReadPosM1 : MC_ReadActualPosition;
	fbReadPosM2 : MC_ReadActualPosition;
	fbReadPosM3 : MC_ReadActualPosition;
	MinPosBeta: LREAL;
	
	NeutralOffsetBeta: LREAL;
	NutPosBeta: LREAL;
	MinPositionThM2: LREAL;
	NeutralOffsetM2: LREAL;
	NeutralOffsetM3: LREAL;
	MinPositionThM3: LREAL;
	MinPoTheta: LREAL;
	NeutralOffsetM2M3Theta: LREAL;
	NutPosTheta: LREAL;
	MinPositionRM2: LREAL;
	MinPositionRM3: LREAL;
	MinPoR: LREAL;
	NeutralOffsetM2M3R: LREAL;
	NutPosR: LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
(* ========================== *)
(*       HOMING LOGIC         *)
(* ========================== *)

(* update switch values from global DWORD *)
SwTheta1 	 := (GVL_MicroSwitch.dwMicroSwitchDriverA AND 16#00020000) <> 0;  (* bit 0 *)
SwTheta2     := (GVL_MicroSwitch.dwMicroSwitchDriverA AND 16#00010000) <> 0;  (* bit 1 *)
SwR1    	 := (GVL_MicroSwitch.dwMicroSwitchDriverB AND 16#00080000) <> 0;  (* bit 0 *)
SwR2  		 := (GVL_MicroSwitch.dwMicroSwitchDriverB AND 16#00040000) <> 0;  (* bit 1 *)
SwBeta1      := (GVL_MicroSwitch.dwMicroSwitchDriverB AND 16#00020000) <> 0;  (* bit 2 *)
SwBeta2      := (GVL_MicroSwitch.dwMicroSwitchDriverB AND 16#00010000) <> 0;  (* bit 3 *)
		
			fbVelM1(
            Axis        := GVL_Axes.Axis1,
			velocity := vBetaHome,
			Acceleration := 1.0,
            Deceleration := 1000.0 );
			
			fbVelM2(
            Axis        := GVL_Axes.Axis2,
			velocity := vThetaHome,
			Acceleration := 1.0,
            Deceleration := 1000.0 );

        	fbVelM3(
            Axis        := GVL_Axes.Axis3,
			velocity := vThetaHome,
			Acceleration := 1.0,
            Deceleration := 1000.0 );
			
		fbStopM1(
            Axis         := GVL_Axes.Axis1,
            Deceleration := 1000.0);
		fbStopM2(
            Axis         := GVL_Axes.Axis2,
            Deceleration := 1000.0);
			
		fbStopM3(
            Axis         := GVL_Axes.Axis3,
            Deceleration := 1000.0);
			
		fbStopLockM1(
            Axis         := GVL_Axes.Axis1);
		fbStopLockM2(
            Axis         := GVL_Axes.Axis2);
		fbStopLockM3(
            Axis         := GVL_Axes.Axis3);	
			
			
// Reading Torque
TorqueM1 := GVL_Torque.TorqueM1_Act;
TorqueM2 := GVL_Torque.TorqueM2_Act;
TorqueM3 := GVL_Torque.TorqueM3_Act;	

// Reading Actual Position
fbReadPosM1(Axis := GVL_Axes.Axis1, Enable := TRUE);
fbReadPosM2(Axis := GVL_Axes.Axis2, Enable := TRUE);
fbReadPosM3(Axis := GVL_Axes.Axis3, Enable := TRUE);


// Mechanical Stopper
tOverTorque(
    IN := ABS(TorqueM1)  > TorqueLimitHome OR (ABS(TorqueM2)+ ABS(TorqueM3))  > TorqueLimitHome,
    PT := T#50MS);	
	IF toverTorque.Q  THEN
    (* stop all motors safely *)
    fbVelM1.Execute := FALSE;
    fbVelM2.Execute := FALSE;
    fbVelM3.Execute := FALSE;

    fbStopLockM1.Execute := TRUE;
    fbStopLockM2.Execute := TRUE;
	fbStopLockM3.Execute := TRUE;

    HomingError := TRUE;
       
END_IF

// Function Block - Move to Neutral Position
fbMoReM1(
 Axis:= GVL_Axes.Axis1,
 Velocity := vBetaHome,
 Acceleration := 10,
 Deceleration := 1000);
 
 fbMoReM2(
 Axis:= GVL_Axes.Axis2,
  Velocity := vThetaHome,
 Acceleration := 10,
 Deceleration := 1000);
 
 fbMoReM3(
 Axis:= GVL_Axes.Axis3,
 Velocity := vThetaHome,
 Acceleration := 10,
 Deceleration := 1000);
 
 

// Homing Motor A - Motor1
IF NOT HomingError THEN 
	
CASE StateM1Homing OF

    0:  (* IDLE *)
        HM1Done := FALSE;
        IF HStart THEN
            StateM1Homing := 10;      (* start beta homing *)
        END_IF


    10: (* HOME Beta: move pure -beta until SwBeta *)
        fbVelM1.Execute := TRUE;
		fbVelM1.Direction := MC_Direction.MC_Negative_Direction;
		rSwBeta1(CLK := SwBeta1);

         IF rSwBeta1.Q THEN 
                     
            MinPosBeta := fbReadPosM1.Position; 
		   	StateM1Homing := 15;
			
         
        END_IF
	
		
	15: (* WAIT UNTIL STOP AFTER THETA *)
        fbVelM1.Execute := FALSE;
		fbStopM1.Execute   := TRUE;
                 

        IF fbStopM1.Done THEN
            
            StateM1Homing := 17;   (* now ready for R homing *)
			NeutralOffsetBeta := ((121297.0/10000.0)/2) + ABS(fbReadPosM1.Position - MinPosBeta);
			
        END_IF
		
	17: (*Motor MOVE TO nutral position*)
	fbStopM1.Execute := FALSE;
    fbMoReM1.Execute := TRUE;
	fbMoReM1.Distance := NeutralOffsetBeta;
	
	IF fbMoReM1.Done THEN
		StateM1Homing := 20;
		NutPosBeta := fbReadPosM1.Position; 
		GVL_HomingResult.gHoming.HomePos_Beta :=NutPosBeta; 
	END_IF
	
	


    20: (* Homming of M1 is DONE *)
			
			fbMoReM1.Execute := FALSE;
			HM1Done := TRUE;

       
END_CASE





// Homing Motor B & C - (Motor 2 & 3)

CASE StateM2M3Homing OF

    0:  (* IDLE *)
        HM123Done := FALSE;

        IF HM1Done THEN
            StateM2M3Homing := 10;      (* start θ homing *)
        END_IF


    10: (* HOME THETA: move pure -theta until SwTheta *)
        fbVelM2.Execute := TRUE;
		fbVelM2.Direction := MC_Direction.MC_Positive_Direction;
		fbVelM3.Execute := TRUE;
		fbVelM3.Direction := MC_Direction.MC_Positive_Direction;
		rSwTheta1(CLK := SwTheta1);
		
		IF rSwTheta1.Q THEN 
                     
            MinPositionThM2 := fbReadPosM2.Position; 
			MinPositionThM3 := fbReadPosM3.Position;
			MinPoTheta := MinPositionThM2+MinPositionThM3;
		   	StateM2M3Homing := 15;
			
         
        END_IF
        
		
	15: (* WAIT UNTIL STOP AFTER THETA *)
			fbVelM2.Execute := FALSE;
			fbVelM3.Execute := FALSE;       
			fbStopM2.Execute   := TRUE;
      		fbStopM3.Execute   := TRUE;
            

        IF fbStopM2.Done AND fbStopM3.Done THEN
            
            StateM2M3Homing := 17;   (* now ready for R homing *)
			NeutralOffsetM2M3Theta := ((1.6384/360.0)*60.0) + MIN (ABS(fbReadPosM2.Position - MinPositionThM2), ABS(fbReadPosM3.Position - MinPositionThM3));
       // ((5000/10000)/2)
 END_IF
		
	17: (*Motors MOVE TO nutral position of THETA*)
		fbStopM2.Execute := FALSE;
		fbStopM3.Execute := FALSE;
		fbMoReM2.Execute := TRUE;
		fbMoReM3.Execute := TRUE;
		fbMoReM2.Distance := - NeutralOffsetM2M3Theta;
		fbMoReM3.Distance := - NeutralOffsetM2M3Theta;
		
	
	IF (fbMoReM2.Done AND fbMoReM3.Done) THEN
		StateM2M3Homing := 20;
		NutPosTheta := fbReadPosM2.Position + fbReadPosM3.Position; 
		GVL_HomingResult.gHoming.HomePos_Theta := NutPosTheta; 
	END_IF


    20: (* HOME R: move pure -R until SwR *)
		fbMoReM2.Execute := FALSE;
		fbMoReM3.Execute := FALSE; 
        fbVelM2.Execute   := TRUE;
		fbVelM2.Direction := MC_Direction.MC_Negative_Direction;
        fbVelM3.Execute   := TRUE;
		fbVelM3.Direction := MC_Direction.MC_Positive_Direction;
	
        rSwR2(CLK := SwR2);
		
		IF rSwR2.Q THEN 
                     
            MinPositionRM2 := fbReadPosM2.Position; 
			MinPositionRM3 := fbReadPosM3.Position;
			MinPoR := MinPositionRM2-MinPositionRM3;
			StateM2M3Homing := 25;
			
         END_IF
		 
	 
       

 
		
	25: (* WAIT UNTIL STOP AFTER R *)
		fbVelM3.Execute   := FALSE;
		fbVelM3.Execute   := FALSE;
        fbStopM2.Execute := TRUE;
        fbStopM3.Execute := TRUE;

        IF fbStopM2.Done AND fbStopM3.Done THEN
			
            
            StateM2M3Homing := 27;     (* finished homing *)
			NeutralOffsetM2M3R := (((16384.0/10000.0)/80.0)*5.0) + MIN (ABS(fbReadPosM2.Position - MinPositionRM2), ABS(fbReadPosM3.Position - MinPositionRM3));
        END_IF
		
	27: (*Motors MOVE TO nutral position of R*)
		fbStopM2.Execute := FALSE;
		fbStopM3.Execute := FALSE;
		fbMoReM2.Execute := TRUE;
		fbMoReM3.Execute := TRUE;
		fbMoReM2.Distance := NeutralOffsetM2M3R;
		fbMoReM3.Distance := -NeutralOffsetM2M3R;  // negative?
		
		IF (fbMoReM2.Done AND fbMoReM3.Done) THEN
		StateM2M3Homing := 30;
		NutPosR := fbReadPosM2.Position - fbReadPosM3.Position;
		GVL_HomingResult.gHoming.HomePos_R := NutPosR;  
	END_IF
	


    30: (* DONE *)
			fbMoReM2.Execute := FALSE;
			fbMoReM3.Execute := FALSE;
			fbStopM2.Execute   := FALSE;
        	fbStopM3.Execute   := FALSE;
       		HM123Done := TRUE;

        (* Wait for next cycle of HStart=FALSE before resetting *)
        IF NOT HStart THEN
            StateM2M3Homing := 0;   (* ready for next command *)
        END_IF

END_CASE

END_IF]]></ST>
    </Implementation>
