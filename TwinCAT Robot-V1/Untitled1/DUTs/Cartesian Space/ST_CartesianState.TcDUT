  <DUT Name="ST_CartesianState" Id="{30eb5419-55ae-472d-8ed3-be5b7fd0d153}">
    <Declaration><![CDATA[TYPE ST_CartesianState :
STRUCT
	Position : ST_CartesianPose;     // Contains X, Y, Theta
    Velocity : ST_CartesianVelocity; // Contains Vx, Vy, Vtheta
	Force    : ST_CartesianForces;    // Contains Fx, Fy, Mtheta
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
