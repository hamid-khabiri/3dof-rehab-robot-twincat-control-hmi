<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_CartesianTarget" Id="{4adedc87-c1a6-49c1-8f3e-30c1d84080d8}">
    <Declaration><![CDATA[TYPE ST_CartesianTarget :
STRUCT
	Position : ST_CartesianPose;     // Game target position
    Velocity : ST_CartesianVelocity; // Feedforward target velocity
    Force    : ST_CartesianForces;    // Force setpoint (e.g. 0 N for admittance)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>