  <DUT Name="ST_JointState" Id="{0c8b5c8e-0329-4950-a554-eafb32957ea2}">
    <Declaration><![CDATA[TYPE ST_JointState :
STRUCT
	Position : ST_JointPose; // Current joint angles (J1, J2, J3)
    Velocity : ST_JointVelocity; // Current joint speeds (J1, J2, J3)
    Torque   : ST_JointTorque; // Measured motor torques (J1, J2, J3)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
